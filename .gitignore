# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
*.moved-aside
build/
DerivedData/

# CocoaPods
# Pods/ is regenerated by `pod install` and not committed. Podfile.lock is also
# ignored here: this is a demo app whose only dependency is already pinned to an
# exact git tag in the Podfile, so the lock adds churn (alpha re-tags, merge
# conflicts) without meaningful reproducibility.
Pods/
Podfile.lock

# Swift Package Manager (local build artifacts)
.build/
.swiftpm/

# JetBrains IDE
.idea/
